# /etc/cadvisor/cadvisor — EnvironmentFile for cadvisor.service.
#
# Defaults match google/cadvisor v0.49.2. Flag names are kebab-case
# (--listen-ip, not -listen_ip; upstream spellings are rejected, #9).
# Go-style single-dash is accepted (-port 8080).
# Defaults: -port 8080, containerd at /run/containerd/containerd.sock
# (namespace k8s.io), CRI-O at /var/run/crio/crio.sock; missing runtime
# sockets degrade gracefully to raw-cgroup monitoring.

CADVISOR_ARGS=
